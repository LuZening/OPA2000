# =============================================================================
#  OPA2000 - single repository for hardware design + firmware
#
#  Layout:
#    LCEDA/ MCU_2/ Power_2/ RF_2/ LPF_2/ Interface_2/   hardware design sources
#    Code_2/                                            firmware projects
#      OPA2000_h7/                                      main firmware
#      OPA2000_h7_Bootloader/  OPA2000_h7_MSC_TEMPLATE/
#      H7B0ZB_W25Q128_HSI_ExternalLoader/  OPA2000_MCU_simple_test/
#
#  The firmware history was folded in with `git subtree`, so Code_2/OPA2000_h7
#  carries its full original commit history - see `git log -- Code_2/OPA2000_h7`.
#  Code_2/OPA2000_h7/.gitignore applies to that subtree and still excludes its
#  own build output; the rules below cover the other sub-projects.
# =============================================================================

# --- Vendor reference material (datasheets, vendor app notes) -----------------
# 257 MB of third-party PDFs and vendor documentation.  Not our design work,
# and re-downloadable from the vendor, so it stays out of the repository.
reference/

# --- Build artefacts ----------------------------------------------------------
build/
cmake-build-*/
Debug/
Release/
*.o
*.obj
*.su
*.dep
*.d
*.map
*.elf
*.hex
*.bin
*.lst

# --- CubeIDE project metadata (regenerated on every import / tool update) ------
.settings/
.project
.cproject
.mxproject

# --- Tooling caches ----------------------------------------------------------
.vscode/
.trae/
.claude/
compile_commands.json

# --- EDA caches and autosaves -------------------------------------------------
# Every tool rewrites these on open; tracking them creates a diff storm.
fp-info-cache
*-cache.lib
*-bak/
*-cache/
*.bak
*-bak
_autosave-*
*.lck
*.kicad_prl
*.pro-bak
*.sch-bak
*.kicad_pcb-bak
prl_*.prl

# Office lock and temp files (~$doc.docx, ~WRL1580.tmp)
~$*
~WRL*.tmp

# --- Simulation exports (regenerable, and large) ------------------------------
# The .asc beside them is the actual AWR design source and stays tracked.
# .fft is 64 MB and .raw 13 MB, both re-exported from the design in seconds.
MCU_2/*.fft
MCU_2/*.raw
MCU_2/*.op.raw
MCU_2/*.plt
MCU_2/*.log
MCU_2/InteractiveBOM_*.html
RF_2/InteractiveBOM_*.html

# --- Misc ---------------------------------------------------------------------
*.tmp
*.stackdump

# --- Local scratch ------------------------------------------------------------
# Backup of the OPA2000_h7 standalone repo, kept until the subtree merge is
# verified on a remote.  Delete once the push to GitHub is confirmed.
.git_backup_opa2000_h7/
reminders.txt
